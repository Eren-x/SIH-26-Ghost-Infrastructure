{
  "name": "ghost-rover",
  "version": "1.0.0",
  "description": "Real-time 3D digital twin simulation of an autonomous infrastructure inspection rover with multi-sensor anomaly detection",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Dipansh Das",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipanshdas/ghost-rover.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm run --prefix client dev",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
